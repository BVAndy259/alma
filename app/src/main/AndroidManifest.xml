<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<application
			android:allowBackup="true"
			android:dataExtractionRules="@xml/data_extraction_rules"
			android:fullBackupContent="@xml/backup_rules"
			android:icon="@mipmap/ic_launcher"
			android:label="@string/app_name"
			android:roundIcon="@mipmap/ic_launcher_round"
			android:supportsRtl="true"
			android:theme="@style/Theme.Controlusuarios">
		<provider
				android:name="androidx.core.content.FileProvider"
				android:authorities="${applicationId}.fileprovider"
				android:exported="false"
				android:grantUriPermissions="true">
			<meta-data
					android:name="android.support.FILE_PROVIDER_PATHS"
					android:resource="@xml/file_paths" />
		</provider>
		<activity
				android:name=".iu.profile.ProfileActivity"
				android:exported="false"
				android:windowSoftInputMode="adjustResize"/>
		<activity
				android:name=".iu.about.AboutAppActivity"
				android:exported="false"/>
		<activity
				android:name=".iu.usermanagement.UserManagementActivity"
				android:exported="false"/>
		<activity
				android:name=".iu.viewspermonth.ViewsPerMonthActivity"
				android:exported="false"/>
		<activity
				android:name=".iu.activenew.ActiveNewUsersActivity"
				android:exported="false"/>
		<activity
				android:name=".iu.dashboard.DashboardActivity"
				android:exported="false"/>
		<activity
				android:name=".iu.register.RegisterActivity"
				android:exported="false"
				android:windowSoftInputMode="adjustResize"/>
		<activity
				android:name=".iu.main.SplashActivity"
				android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>

				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
		<activity
				android:name=".iu.main.MainActivity"
				android:exported="false" />
	</application>

</manifest>