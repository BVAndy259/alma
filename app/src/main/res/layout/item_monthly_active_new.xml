<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvMonthPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/month_unknown"
        android:fontFamily="@font/jomolhari_regular"
        android:textColor="@color/white_70"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvMonthValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/active_new_month_values_placeholder"
        android:fontFamily="@font/jomolhari_regular"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/pbMonthActive"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0" />

</LinearLayout>



