<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/main">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/todo"
            android:src="@drawable/login_bg"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#DD001A1A" />

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp">

                    <ImageView
                        android:id="@+id/ivMenu"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/menu_ic"
                        app:tint="@color/titules"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Menu"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivMenu"
                        android:layout_toStartOf="@+id/ivLogo"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:id="@+id/tvTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_title"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvDashboardReport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_report"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/titules"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/company_lg"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_period"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/titules"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/spinnerYear"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_input_rounded"
                                android:paddingHorizontal="12dp"/>

                            <Spinner
                                android:id="@+id/spinnerMonth"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_input_rounded"
                                android:paddingHorizontal="12dp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSelectedPeriod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_report"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white_70"
                            android:textSize="12sp"
                            android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/traffic"
                    android:fontFamily="@font/jomolhari_regular"
                    android:textColor="@color/titules"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_views"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white_70"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvTotalVisitsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15,840"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sessions"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white_70"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvSessionsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12,150"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/behavior"
                    android:fontFamily="@font/jomolhari_regular"
                    android:textColor="@color/titules"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/assets"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white_70"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/tvAssetsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8,420"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/titules"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/white_30"
                            android:layout_marginHorizontal="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/news"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white_70"
                                android:textSize="13sp"/>
                            <TextView
                                android:id="@+id/tvNewValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3,105"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trend_title"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trend_subtitle"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white_70"
                            android:textSize="12sp"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout
                            android:id="@+id/trafficBarsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="32dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvTasaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/interaction"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white_70"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvInteractionValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="68.5%"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_below="@id/tvTasaLabel"
                            android:layout_marginTop="2dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/source"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/white_70"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvSourceValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orgánico"
                                android:fontFamily="@font/jomolhari_regular"
                                android:textColor="@color/titules"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sources_title"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/tvSourcesList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no_source_data"
                            android:fontFamily="@font/jomolhari_regular"
                            android:textColor="@color/white_70"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/nav_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EF001A1A"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/company_lg"
                android:layout_marginBottom="24dp"
                android:contentDescription="Logo de la compañia"/>

            <TextView
                android:id="@+id/userDash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:fontFamily="@font/jomolhari_regular"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/userRoleDash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rol"
                android:fontFamily="@font/jomolhari_regular"
                android:textSize="14sp"
                android:textColor="@color/titules"
                android:layout_marginBottom="32dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_30"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCIONES RÁPIDAS"
                android:fontFamily="@font/jomolhari_regular"
                android:textColor="@color/titules"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/lbl_dashboard"
                android:fontFamily="@font/jomolhari_regular"
                android:backgroundTint="@color/btns"
                android:textColor="@color/alma_button_text"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btnLogOut"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/btn_log_out"
                android:fontFamily="@font/jomolhari_regular"
                android:backgroundTint="@color/btns"
                android:textColor="@color/alma_button_text"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btnAdvanced"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/btn_advanced"
                android:fontFamily="@font/jomolhari_regular"
                android:backgroundTint="@color/btns"
                android:textColor="@color/alma_button_text"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
