<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_about_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_mgmt_dialog_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/jomolhari_regular"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:id="@+id/tvDialogName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:fontFamily="@font/jomolhari_regular"/>

    <TextView
        android:id="@+id/tvDialogEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/white_70"
        android:textSize="13sp"
        android:fontFamily="@font/jomolhari_regular"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/user_mgmt_dialog_role"
        android:textColor="@color/titules"
        android:fontFamily="@font/jomolhari_regular"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spDialogRole"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_rounded"
        android:paddingHorizontal="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/user_mgmt_dialog_active"
            android:textColor="@color/titules"
            android:textStyle="bold"
            android:fontFamily="@font/jomolhari_regular"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDialogActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/btns"
            app:trackTint="@color/white_30"/>
    </LinearLayout>
</LinearLayout>


