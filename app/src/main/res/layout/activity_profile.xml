<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/todo"
        android:src="@drawable/login_bg"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD001A1A" />

    <ScrollView
        android:id="@+id/scrollProfile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/btnBackProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/profile_back"
                    android:padding="8dp"
                    android:background="@drawable/bg_stat_card"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_title"
                    android:fontFamily="@font/jomolhari_regular"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivProfilePreview"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/profile_photo"
                android:src="@drawable/company_lg" />

            <Button
                android:id="@+id/btnPickPhoto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:text="@string/profile_photo_options"
                android:fontFamily="@font/jomolhari_regular"
                android:backgroundTint="@color/btns"
                android:textColor="@color/alma_button_text"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <EditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="16dp"
                android:hint="@string/lbl_name"
                android:background="@drawable/bg_input_rounded"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_primary"
                android:fontFamily="@font/jomolhari_regular"
                android:padding="12dp"
                android:inputType="textPersonName"
                android:autofillHints="name" />

            <EditText
                android:id="@+id/etProfileLastName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="16dp"
                android:hint="@string/lbl_lastName"
                android:background="@drawable/bg_input_rounded"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_primary"
                android:fontFamily="@font/jomolhari_regular"
                android:padding="12dp"
                android:inputType="textPersonName"
                android:autofillHints="familyName" />

            <LinearLayout
                android:id="@+id/containerPhoneProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_call"
                    android:contentDescription="@string/profile_phone_hint"
                    app:tint="@color/titules"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/profile_phone_hint"
                    android:background="@android:color/transparent"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_primary"
                    android:fontFamily="@font/jomolhari_regular"
                    android:padding="0dp"
                    android:inputType="phone"
                    android:autofillHints="phone"
                    android:maxLines="1" />
            </LinearLayout>

            <EditText
                android:id="@+id/etProfession"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="@string/profile_profession_hint"
                android:background="@drawable/bg_input_rounded"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_primary"
                android:fontFamily="@font/jomolhari_regular"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:inputType="textCapWords"
                android:autofillHints="jobTitle"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:contentDescription="@string/profile_birth_hint"
                    app:tint="@color/titules"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/etBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/profile_birth_hint"
                    android:background="@android:color/transparent"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_primary"
                    android:fontFamily="@font/jomolhari_regular"
                    android:padding="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:inputType="date"
                    android:cursorVisible="false"
                    android:maxLines="1"
                    android:autofillHints="birthDateDay" />
            </LinearLayout>

            <EditText
                android:id="@+id/etInstagram"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:gravity="top"
                android:hint="@string/profile_instagram_hint"
                android:background="@drawable/bg_input_rounded"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_primary"
                android:fontFamily="@font/jomolhari_regular"
                android:padding="12dp"
                android:layout_marginBottom="24dp"
                android:inputType="textUri"
                android:autofillHints="username"/>

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/profile_save"
                android:fontFamily="@font/jomolhari_regular"
                android:backgroundTint="@color/btns"
                android:textColor="@color/alma_button_text"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>

